{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "rootDir": "./projects/ngx-modialog/src",
    "sourceMap": true,
    "esModuleInterop": true,
    "paths": {
      "ngx-modialog": [
        "./dist/ngx-modialog"
      ]
    },
    "strict": false,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false
  }
}
